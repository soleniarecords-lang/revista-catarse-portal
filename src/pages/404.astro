---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada">
	<div class="wrap">
		<header class="cab-quadro">
			<div class="filete" style="background:var(--acento)"></div>
			<h1>Página não encontrada</h1>
			<p class="desc">O endereço não existe ou a matéria ainda não foi publicada.</p>
			<p class="desc"><a href="/" style="text-decoration:underline">Voltar para o início</a></p>
		</header>
	</div>
</Base>
