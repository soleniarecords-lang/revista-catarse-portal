---
import Base from '../../layouts/Base.astro';
import Cartao from '../../components/Cartao.astro';
import { quadros } from '../../data/quadros';
import { getMaterias } from '../../lib/materias';

export function getStaticPaths() {
	return quadros.map((q) => ({ params: { quadro: q.slug }, props: { q } }));
}

const { q } = Astro.props;
const materias = (await getMaterias()).filter((m) => m.quadro.slug === q.slug);
---

<Base titulo={q.nome} descricao={`${q.chamada}: ${q.descricao}`}>
	<div class="wrap">
		<header class="cab-quadro">
			<div class="filete" style={`background:${q.cor}`}></div>
			<h1>{q.nome}</h1>
			<p class="chamada">{q.chamada}</p>
			<p class="desc">{q.descricao}</p>
		</header>
		<h2 class="titulo-secao">{materias.length} {materias.length === 1 ? 'matéria' : 'matérias'}</h2>
		{
			materias.length ? (
				<div class="grade">{materias.map((m) => <Cartao materia={m} />)}</div>
			) : (
				<p class="vazio">Ainda não há matérias neste quadro.</p>
			)
		}
	</div>
</Base>
