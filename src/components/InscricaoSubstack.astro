---
// Formulário de inscrição oficial da Substack (embed). O cadastro acontece lá; o portal não guarda e-mail.
import { SUBSTACK_URL } from '../data/site';
---

<section class="inscricao" aria-labelledby="titulo-inscricao">
	<div class="texto">
		<p class="rotulo">Newsletter</p>
		<h2 id="titulo-inscricao">Receba a Catarse</h2>
		<p class="sub">As edições e os textos da revista, direto no seu e-mail.</p>
	</div>
	<iframe
		src={`${SUBSTACK_URL}/embed`}
		title="Inscreva-se na newsletter da Revista Catarse"
		width="480"
		height="320"
		loading="lazy"
		style="border:0;background:#fff;"></iframe>
</section>

<style>
	.inscricao {
		display: grid;
		grid-template-columns: 1fr minmax(0, 480px);
		gap: 36px;
		align-items: center;
		margin-top: 96px;
		padding: 40px;
		border: 1px solid var(--linha);
		border-radius: var(--raio);
		/* gradiente verde granulado (o granulado é a primeira camada do fundo) */
		background:
			var(--grao-img),
			radial-gradient(70% 110% at 0% 0%, color-mix(in srgb, var(--acento) var(--capa-f1), var(--capa-mistura)) 0%, transparent 72%),
			radial-gradient(60% 100% at 100% 100%, color-mix(in srgb, var(--acento) var(--capa-f2), var(--capa-mistura)) 0%, transparent 70%),
			var(--capa-base);
		background-size: 220px 220px, auto, auto, auto;
	}
	.rotulo {
		margin: 0 0 12px;
	}
	.texto h2 {
		margin: 0 0 10px;
		font-family: var(--f-titulo);
		font-style: italic;
		font-weight: 800;
		font-size: clamp(30px, 4.2vw, 46px);
		line-height: 1.05;
		letter-spacing: -0.015em;
	}
	.sub {
		margin: 0;
		font-family: var(--f-corpo);
		font-size: 17px;
		line-height: 1.55;
		color: var(--mute);
		max-width: 34ch;
	}
	iframe {
		width: 100%;
		max-width: 480px;
		height: 320px;
		border-radius: 12px;
	}
	@media (max-width: 820px) {
		.inscricao {
			grid-template-columns: 1fr;
			padding: 28px 22px;
		}
	}
</style>
