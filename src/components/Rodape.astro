---
import { getPaginas } from '../lib/paginas';
import { REDACAO, hrefAutor } from '../data/autores';
import { INSTAGRAM_URL, SUBSTACK_URL, TIKTOK_URL } from '../data/site';

const ano = new Date().getFullYear();
const paginas = await getPaginas();
---

<footer>
	<div class="wrap dentro">
		<p class="marca-rodape">Revista Catarse</p>
		<p class="lema">A voz do indie</p>
		<nav class="links" aria-label="Institucional">
			{paginas.map((p) => <a href={`/${p.id}/`}>{p.data.titulo}</a>)}
			<a href={hrefAutor(REDACAO)}>{REDACAO.nome}</a>
			<a href={SUBSTACK_URL} rel="noopener">Substack</a>
			<a href={INSTAGRAM_URL} rel="me noopener">Instagram</a>
			<a href={TIKTOK_URL} rel="me noopener">TikTok</a>
			<button type="button" class="link-cookies" data-abrir-cookies>Preferências de cookies</button>
		</nav>
		<p class="peq">Produzida e distribuída por Solenia Records · © {ano}</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 96px;
		border-top: 1px solid var(--linha);
		padding: 44px 0 64px;
		text-align: center;
	}
	.marca-rodape {
		margin: 0;
		font-family: var(--f-titulo);
		font-style: italic;
		font-weight: 800;
		font-size: 30px;
		letter-spacing: -0.01em;
	}
	.lema {
		margin: 4px 0 22px;
		font-size: 11.5px;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--mute);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px 28px;
		margin-bottom: 24px;
		font-size: 11.5px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--mute);
	}
	.link-cookies {
		border: 0;
		background: none;
		padding: 0;
		font: inherit;
		color: inherit;
		cursor: pointer;
	}
	.link-cookies:hover {
		color: var(--acento-texto);
	}
	.links a:hover {
		color: var(--acento-texto);
	}
	.peq {
		margin: 0;
		font-size: 12px;
		color: var(--mute-2);
	}
</style>
