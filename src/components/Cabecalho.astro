---
import type { Quadro } from '../data/quadros';
import { SUBSTACK_URL as substack } from '../data/site';
import Busca from './Busca.astro';

interface Props {
	atual: string;
	quadros: Quadro[];
}
const { atual, quadros } = Astro.props;
const ativa = (href: string) => (href === '/' ? atual === '/' : atual.startsWith(href));
---

<header class="topo">
	<div class="wrap mast">
		<div class="esq">
			<button class="tema" type="button" data-alternar-tema aria-label="Alternar entre tema claro e escuro" title="Tema claro / escuro">
				<svg class="ic-lua" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path fill="currentColor" d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a.6.6 0 0 0-.8-.7A9.5 9.5 0 1 0 21.2 15a.6.6 0 0 0-.7-.8Z" />
				</svg>
				<svg class="ic-sol" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<circle cx="12" cy="12" r="4.2" fill="currentColor" />
					<g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
						<path d="M12 2.5v2.3M12 19.2v2.3M2.5 12h2.3M19.2 12h2.3M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6" />
					</g>
				</svg>
			</button>
			<button class="tema" type="button" data-abrir-busca aria-label="Buscar no site" title="Buscar (atalho: /)">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<circle cx="10.5" cy="10.5" r="6.2" fill="none" stroke="currentColor" stroke-width="2" />
					<path d="m15.3 15.3 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
			</button>
		</div>
		<a href="/" class="logo" aria-label="Revista Catarse, página inicial"></a>
		<div class="dir">
			<a class="botao" href={`${substack}/subscribe`} rel="noopener">Assinar</a>
		</div>
	</div>
	<nav class="faixa" aria-label="Seções">
		<div class="wrap itens">
			<a href="/" class:list={['aba', { ativa: ativa('/') }]}>Início</a>
			<a href="/noticias/" class:list={['aba', { ativa: ativa('/noticias/') }]}>Notícias</a>
			<a href="/podcast/" class:list={['aba', { ativa: ativa('/podcast/') }]}>Podcasts</a>
			<details class="quadros-menu" data-menu-quadros>
				<summary class:list={['aba', { ativa: atual.startsWith('/quadros/') }]}>
					Quadros
					<svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</summary>
				<div class="painel">
					<div class="wrap grade-quadros">
						{
							quadros.map((q) => (
								<a href={`/quadros/${q.slug}/`} class:list={['item-quadro', { ativa: ativa(`/quadros/${q.slug}/`) }]}>
									<span class="nome"><i class="marca" style={`background:${q.cor}`}></i>{q.nome}</span>
									<span class="chamada">{q.chamada}</span>
								</a>
							))
						}
					</div>
				</div>
			</details>
		</div>
	</nav>
	<Busca />
</header>

<script>
	// o menu "Quadros" fecha ao clicar fora, ao escolher um quadro ou com Esc
	const menu = document.querySelector<HTMLDetailsElement>('[data-menu-quadros]');
	if (menu) {
		document.addEventListener('click', (e) => {
			if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') menu.open = false;
		});
	}

	// alterna o tema e guarda a escolha neste navegador
	document.querySelectorAll('[data-alternar-tema]').forEach((botao) => {
		botao.addEventListener('click', () => {
			const raiz = document.documentElement;
			const novo = raiz.dataset.tema === 'escuro' ? 'claro' : 'escuro';
			raiz.dataset.tema = novo;
			try {
				localStorage.setItem('tema', novo);
			} catch {}
			document.querySelector('meta[name="theme-color"]')?.setAttribute('content', novo === 'escuro' ? '#050706' : '#fbfcfb');
		});
	});
</script>

<style>
	.topo {
		position: relative;
		z-index: 30; /* o painel do menu Quadros precisa ficar acima do destaque */
	}
	.mast {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		height: 104px;
	}
	.esq {
		justify-self: start;
		display: flex;
		gap: 10px;
	}
	.dir {
		justify-self: end;
	}
	/* wordmark com fundo transparente (scripts/gerar-logos.mjs): letra preta no tema claro, branca no escuro */
	.logo {
		display: block;
		width: 230px;
		aspect-ratio: 605 / 225;
		background: url('/logo-catarse-texto-preto.png') center / contain no-repeat;
	}
	:global(:root[data-tema='escuro']) .logo {
		background-image: url('/logo-catarse-texto-branco.png');
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-tema])) .logo {
			background-image: url('/logo-catarse-texto-branco.png');
		}
	}

	.tema {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		border: 1px solid var(--linha);
		background: color-mix(in srgb, var(--elevado) 80%, transparent);
		color: var(--tinta);
		cursor: pointer;
		transition: border-color 0.15s, background 0.15s;
	}
	.tema:hover {
		border-color: var(--acento);
	}
	/* no claro mostra a lua (vai para o escuro); no escuro mostra o sol */
	.ic-sol {
		display: none;
	}
	:global(:root[data-tema='escuro']) .ic-sol {
		display: block;
	}
	:global(:root[data-tema='escuro']) .ic-lua {
		display: none;
	}

	/* faixa de navegação: maiúsculas espaçadas entre linhas finas (The Dissolve / Avaunt) */
	.faixa {
		border-top: 1px solid var(--linha);
		border-bottom: 1px solid var(--linha);
		background: color-mix(in srgb, var(--bg) 82%, transparent);
	}
	.itens {
		display: flex;
		align-items: center;
		justify-content: safe center;
		flex-wrap: wrap;
		gap: 0 30px;
	}
	.aba {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 15px 0 13px;
		font-family: var(--f-ui);
		font-size: 11.5px;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--mute);
		border-bottom: 2px solid transparent;
		white-space: nowrap;
		transition: color 0.15s;
	}
	.aba:hover {
		color: var(--tinta);
	}
	.aba.ativa {
		color: var(--tinta);
		border-bottom-color: var(--acento);
	}
	/* menu Quadros (details): painel largo com os 8 quadros, cada um com sua chamada */
	.quadros-menu {
		position: static;
	}
	.quadros-menu summary {
		list-style: none;
		cursor: pointer;
	}
	.quadros-menu summary::-webkit-details-marker {
		display: none;
	}
	.quadros-menu summary svg {
		transition: transform 0.15s;
	}
	.quadros-menu[open] summary svg {
		transform: rotate(180deg);
	}
	.quadros-menu[open] summary {
		color: var(--tinta);
	}
	.painel {
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		z-index: 20;
		border-bottom: 1px solid var(--linha);
		background: var(--bg);
		box-shadow: 0 24px 40px -28px rgba(0, 0, 0, 0.35);
	}
	.grade-quadros {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 4px 28px;
		padding-top: 22px;
		padding-bottom: 26px;
	}
	.item-quadro {
		display: flex;
		flex-direction: column;
		gap: 3px;
		padding: 12px 0;
		border-bottom: 1px solid var(--linha);
	}
	.item-quadro .nome {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		font-family: var(--f-titulo);
		font-weight: 700;
		font-size: 19px;
		line-height: 1.2;
	}
	.item-quadro .chamada {
		padding-left: 18px;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--mute);
	}
	.item-quadro:hover .nome,
	.item-quadro.ativa .nome {
		color: var(--acento-texto);
	}
	@media (max-width: 900px) {
		.grade-quadros {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 480px) {
		.grade-quadros {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.mast {
			height: 84px;
		}
		.logo {
			width: 170px;
		}
		.itens {
			gap: 0 22px;
		}
	}
	@media (max-width: 400px) {
		.esq {
			gap: 6px;
		}
		.tema {
			width: 36px;
			height: 36px;
		}
		.logo {
			width: 112px;
		}
		.dir :global(.botao) {
			padding: 9px 15px;
		}
	}
</style>
