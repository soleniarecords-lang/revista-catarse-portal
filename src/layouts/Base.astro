---
import { Font } from 'astro:assets';
import { quadros } from '../data/quadros';
import { GA_ID, GTM_ID, LEMA, NOME_SITE } from '../data/site';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import '../styles/global.css';

interface Props {
	titulo?: string;
	descricao?: string;
	tipo?: 'website' | 'article';
	imagem?: string;
	publicadoEm?: Date;
	secao?: string;
	jsonld?: object | object[];
}

const {
	titulo,
	descricao = `${LEMA}. Revista da Solenia Records: mercado, bastidores, perfis e ensaios sobre música.`,
	tipo = 'website',
	imagem,
	publicadoEm,
	secao,
	jsonld,
} = Astro.props;

// Google Tag Manager: o trecho do <head> fica o mais alto possível e o <noscript> logo depois de abrir o <body>.
const gtmHead = import.meta.env.PROD
	? `<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${GTM_ID}');</script>
<!-- End Google Tag Manager -->`
	: '';
const gaHead = import.meta.env.PROD
	? `<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=${GA_ID}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', '${GA_ID}');
</script>`
	: '';
const gtmBody = import.meta.env.PROD
	? `<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=${GTM_ID}"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->`
	: '';

const tituloCompleto = titulo ? `${titulo} | ${NOME_SITE}` : `${NOME_SITE}: ${LEMA}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = imagem ? new URL(imagem, Astro.site).href : new URL('/logo-catarse-wide.png', Astro.site).href;
const atual = Astro.url.pathname;
const grafo = jsonld
	? JSON.stringify({ '@context': 'https://schema.org', '@graph': [jsonld].flat() }).replace(/</g, '\\u003c')
	: null;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<Fragment set:html={gtmHead} />
		<Fragment set:html={gaHead} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fbfcfb" />
		<!-- aplica o tema (claro/escuro) antes de pintar a página, para não piscar -->
		<script is:inline>
			(function () {
				var t = null;
				try {
					t = localStorage.getItem('tema');
				} catch (e) {}
				if (t !== 'claro' && t !== 'escuro') {
					t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'escuro' : 'claro';
				}
				// ?tema=claro ou ?tema=escuro força o tema só nesta visita (não grava a escolha)
				var q = /[?&]tema=(claro|escuro)/.exec(location.search);
				if (q) t = q[1];
				document.documentElement.dataset.tema = t;
				var m = document.querySelector('meta[name="theme-color"]');
				if (m) m.setAttribute('content', t === 'escuro' ? '#050706' : '#fbfcfb');
			})();
		</script>
		<link rel="icon" type="image/png" href="/logo-catarse.png" />
		<title>{tituloCompleto}</title>
		<meta name="description" content={descricao} />
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:site_name" content={NOME_SITE} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:type" content={tipo} />
		<meta property="og:title" content={tituloCompleto} />
		<meta property="og:description" content={descricao} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={og} />
		{publicadoEm && <meta property="article:published_time" content={publicadoEm.toISOString()} />}
		{secao && <meta property="article:section" content={secao} />}
		<meta name="twitter:card" content="summary_large_image" />
		<Font cssVariable="--font-titulo" preload />
		<Font cssVariable="--font-corpo" preload />
		<Font cssVariable="--font-ui" preload />
		{grafo && <script type="application/ld+json" set:html={grafo} />}
	</head>
	<body>
		<Fragment set:html={gtmBody} />
		<Cabecalho atual={atual} quadros={quadros} />
		<main>
			<slot />
		</main>
		<Rodape />
	</body>
</html>
